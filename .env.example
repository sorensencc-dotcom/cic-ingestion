# cic-ingestion environment variables

# Server port (default: 3000)
CIC_INGESTION_PORT=3000

# Google Vision API configuration
# Required for real image analysis; optional for development (falls back to mock)
VISION_API_KEY=<your-vision-api-key-or-leave-blank-for-mock>

# Path to Google service account JSON key file
# Required for Google Vision API calls; set this for real analysis
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Vision API provider (currently only 'google_vision' supported)
VISION_API_PROVIDER=google_vision

# FamilySearch (beta). Variable names are exactly what src/adapters/familysearch reads.
# See docs/familysearch-beta-setup.md
FAMILYSEARCH_ENV=beta
FAMILYSEARCH_APP_KEY=
FAMILYSEARCH_REDIRECT_URI=http://localhost:3000/callback
# Paste from `npm run fs:login` output (24h lifetime); never commit
FAMILYSEARCH_ACCESS_TOKEN=
# Optional, only if FamilySearch enabled refresh tokens for the app key
FAMILYSEARCH_REFRESH_TOKEN=
FAMILYSEARCH_CLIENT_SECRET=
# REMOVED, no longer read: FAMILYSEARCH_API_KEY, FAMILYSEARCH_API_URL

# Shared secret required (header x-cic-route-key) to call credentialed adapters such as
# /execute/familysearch. The adapter is not registered unless this is set (16+ chars).
CIC_CREDENTIALED_ROUTE_KEY=
