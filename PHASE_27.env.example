# Phase 27: CIC Integration Configuration

# Server
PORT=3000
NODE_ENV=development

# FamilySearch API (OAuth 2, see https://developers.familysearch.org/main/docs/authentication)
# beta (default) or production. Hosts: apibeta/identbeta vs api/ident .familysearch.org
FAMILYSEARCH_ENV=beta
# App key from the FamilySearch developer console. Used as the OAuth client_id.
FAMILYSEARCH_APP_KEY=
# Minimal path: user-authorized access token (max life 24h)
FAMILYSEARCH_ACCESS_TOKEN=
# Optional, only if FamilySearch enabled refresh tokens for the app key
FAMILYSEARCH_REFRESH_TOKEN=
FAMILYSEARCH_CLIENT_SECRET=

# Warm Pool
WARM_POOL_TTL=3600000
WARM_POOL_MAX_SIZE=1000

# Drift Detection
DRIFT_CONFIDENCE_THRESHOLD=0.5
DRIFT_THRESHOLD=0.3

# SPA Hydration
SPA_LOW_CONFIDENCE_THRESHOLD=0.3

# Webhooks
TORQUE_QUERY_URL=http://localhost:9000
CHAT_AGENT_URL=http://localhost:8000
SLACK_WEBHOOK=
TEAMS_WEBHOOK=

# Webhook Timeout & Retries
WEBHOOK_TIMEOUT=5000
WEBHOOK_RETRIES=3

# Adapter Timeout & Retries
ADAPTER_TIMEOUT=10000
ADAPTER_RETRIES=3

# Logging
LOG_LEVEL=INFO

# Metrics (for Prometheus)
METRICS_PORT=9090
METRICS_ENABLED=true

# Service Discovery
SERVICE_NAME=cic-ingestion
SERVICE_VERSION=1.0.0
